# Godot 4+ cache (Godot khud banata hai, repo me daalne ki zaroorat nahi)
.godot/
~*.dll

# Godot 3 wale .import files (Godot 4 me use nahi hote)
*.import

# Export / build ke outputs
build/
*.apk
*.aab
*.pck

# Native exports
*.exe
export.cfg
export_credentials.cfg
*.tmp

# Android build template (GitHub Actions khud install karta hai)
android/

# Keystore kabhi commit na karo
*.keystore
*.jks

# Imported translations
*.translation

# Mono / C#
.mono/
data_*/
mono_crash.*.json

# OS junk
.DS_Store
Thumbs.db

# CI build log (workflow ikattha karta hai)
build-log.txt

# CC0 model SOURCE files repo me rehte hain: FBX (assets/downloaded/) aur OBJ+MTL
# (assets/downloaded_obj/). Godot inhe padh nahi sakta, isliye build ke waqt
# tools/fbx2glb.py + tools/obj2glb.py unhe .glb me convert karte hain — dekho
# .github/workflows/build-apk.yml step "7d"/"7d-obj". Converted .glb commit NAHI karte.
assets/downloaded/**/*.glb
assets/downloaded/**/*.gltf
assets/downloaded/**/*.fbx.import
assets/downloaded_obj/**/*.glb
assets/downloaded_obj/**/*.gltf
assets/downloaded_obj/**/*.obj.import

# Build ke waqt bane reports
build/glb-report.json

# QA renders (tools/glbpreview.py se bante hain — sirf dekhne ke liye)
qa-renders/

# Python cache (tools/fbx2glb.py CI me chalta hai)
__pycache__/
*.pyc
